<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
</head>
<body>
<div class="container">
    <h1><%= title %></h1>
    <div class="centre-wrapper">
        <div class="card">
            <form action="/apartments" method="POST">
                <label>Район:</label>
                <input type="text" name="district" required />

                <label>Поверх:</label>
                <input type="number" name="floor" min="1" required />

                <label>Площа (м²):</label>
                <input type="number" name="area" min="1" required />

                <label>Кількість кімнат:</label>
                <input type="number" name="rooms" min="1" required />

                <label>ПІБ власника:</label>
                <input type="text" name="ownerFullName" required />

                <label>Телефон власника:</label>
                <input type="text" name="ownerPhone" required />

                <label>Email власника:</label>
                <input type="email" name="ownerEmail" required />

                <label>Ціна ($):</label>
                <input type="number" name="price" min="0" required />

                <div class="actions">
                    <button class="btn btn-primary" type="submit">Зберегти</button>
                    <a class="btn btn-secondary" href="/">Назад</a>
                </div>
            </form>
        </div>
    </div>
</div>
</body>
</html>